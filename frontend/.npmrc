# Freeze dependency versions — no automatic upgrades
save-exact=true
package-lock=true

# npm install scripts stay enabled (set true to block them as supply-chain protection)
ignore-scripts=false

# Enforce lockfile — fail if package-lock.json would change
# Use `npm ci` instead of `npm install` in CI/CD
# prefer-offline when node_modules already installed
prefer-offline=true

# Audit on every install
audit=true
