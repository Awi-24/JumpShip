# ============================================================
# Jumpship — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ------ Provedores de IA (preencha pelo menos um) ----------

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (GPT-4) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq (gratuito, limite diário) — https://console.groq.com/keys
GROQ_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ------ Ollama (modelo local, sem API key) ------------------
# Deixe em branco para usar o padrão: http://localhost:11434
# Com Docker, use: http://host.docker.internal:11434
OLLAMA_HOST=

# ------ V2 Agent System (LangGraph) -------------------------
# LLM model for agents — requires tool-calling support
# Gemma4:Cloud runs via Ollama as gemma3:27b
LLM_MODEL=gemma3:27b
LLM_PROVIDER=ollama
# To pull the model: ollama pull gemma3:27b  (~17 GB)

# Separate SQLite DB for LangGraph checkpoints (agent state persistence)
LANGGRAPH_DB_PATH=./jumpship_agents.db

# ------ Backend --------------------------------------------
# Porta do servidor FastAPI (padrão: 8000)
PORT=8000

# Caminho do banco de dados SQLite
DATABASE_URL=sqlite:///./jobspy_ui.db
