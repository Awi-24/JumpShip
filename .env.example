# JumpShip — copy to `.env` at the repository root (same folder as this file).
# Pydantic and `load_dotenv` both read that path. Docker Compose also substitutes from it.

# --- LLM (at least one provider must be reachable) ---
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:27b
# Local Ollama / LM Studio base URL (Docker: http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Legacy alias still read by some code paths
OLLAMA_HOST=

# Optional LM Studio (OpenAI-compatible), if you use that stack
LMSTUDIO_BASE_URL=http://localhost:1234

# Cloud keys (leave blank if unused)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- HTTP / data ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80
DATABASE_URL=sqlite:///./jobspy_ui.db
UPLOAD_DIR=./uploads
RESUME_OUTPUT_DIR=./generated_resumes

# Fernet encryption for stored secrets (change in production)
SECRET_KEY=dev-secret-change-me-in-production

# Optional: gate API with a shared key
API_KEY=

# Auto-generate tailored résumé PDF when match score >= this (0–100)
RESUME_GEN_THRESHOLD=70
